    {
      "name": "4 - Organisation events and visibility (FR-BRW-04, 06, 07)",
      "item": [
        {
          "name": "Upcoming events (student): only approved or cancelled-after-approval, soonest first",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "pm.test(\"Students never see Pending, Rejected or Changes Requested\", () => b.forEach(e => pm.expect([\"APPROVED\", \"CANCELLED\"]).to.include(e.status)));",
                  "pm.test(\"Cancelled events shown only if cancelled after approval\", () => b.filter(e => e.status === \"CANCELLED\").forEach(e => pm.expect(e.cancelledAfterApproval).to.eql(true)));",
                  "pm.test(\"The pending event from setup is not listed\", () => pm.expect(b.map(e => e.id)).to.not.include(pm.environment.get(\"pendingEventId\")));",
                  "pm.test(\"Soonest first\", () => { const t = b.map(e => e.startAt); pm.expect(t).to.eql([...t].sort()); });",
                  "if (b.length) pm.environment.set(\"approvedEventId\", b[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/organisations/{{dssId}}/events?when=upcoming"
          }
        },
        {
          "name": "Past events (student): most recent first",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.test(\"Most recent first\", () => { const t = b.map(e => e.startAt); pm.expect(t).to.eql([...t].sort().reverse()); });",
                  "pm.test(\"All have ended\", () => b.forEach(e => pm.expect(new Date(e.endAt).getTime()).to.be.below(Date.now())));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/organisations/{{dssId}}/events?when=past"
          }
        },
        {
          "name": "Upcoming events (organiser): also sees own Pending event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
