    {
      "name": "2 - Setup: organiser creates a PENDING event (Ali's endpoint)",
      "item": [
        {
          "name": "Create pending event",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const days = 40 + Math.floor(Math.random() * 600);",
                  "const d = new Date(Date.now() + days * 86400000);",
                  "const day = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());",
                  "pm.environment.set(\"evStart\", new Date(day + 4 * 3600000).toISOString());   // 9:00 AM Pakistan time",
                  "pm.environment.set(\"evEnd\", new Date(day + 6 * 3600000).toISOString());     // 11:00 AM Pakistan time"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const e = pm.response.json(); pm.test(\"Event is PENDING\", () => pm.expect(e.status).to.eql(\"PENDING\")); pm.environment.set(\"pendingEventId\", e.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organiserToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organisationId\": \"{{dssId}}\",\n  \"title\": \"Postman browse check\",\n  \"description\": \"Created by the Postman collection\",\n  \"eventType\": \"Workshop\",\n  \"startAt\": \"{{evStart}}\",\n  \"endAt\": \"{{evEnd}}\",\n  \"capacity\": 20,\n  \"registrationRequired\": false,\n  \"venueId\": \"{{venueId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
