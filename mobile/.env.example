# Copy to .env and fill in. Never commit .env (only this example file).
# API base URL. Examples (Master Document 7.6):
#   Phone on same Wi-Fi:   http://<laptop-IP>:5000/api/v1
#   Android emulator:      http://10.0.2.2:5000/api/v1
#   iOS simulator:         http://localhost:5000/api/v1
#   Deployed API:          https://our-api.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Mock-data switch. true = screens use sample data, no API needed.
# Must be false (or removed) at submission.
EXPO_PUBLIC_USE_MOCKS=true
